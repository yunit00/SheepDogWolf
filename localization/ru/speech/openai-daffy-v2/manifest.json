  },
  {
    "file": "Mars_2sec__04.wav",
    "source_file": "Mars_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "К сожалению, наше шоу почти закончилось.",
    "start": 21.5,
    "end": 24.45,
    "source_seconds": 208.7134375,
    "segments": [
