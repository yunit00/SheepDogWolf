    "qa": "requires independent file QA"
  },
  {
    "file": "Mars_2sec__07.wav",
    "source_file": "Mars_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "А? Это ещё что такое?",
    "start": 31.4,
    "end": 33.15,
    "source_seconds": 208.7134375,
    "segments": [
      7
    ],
    "provider": "OpenAI",
    "voice": "ballad",
