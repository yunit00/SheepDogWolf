    "audio_sha256": "23964434642d2848671fe2e47fc2d39cb95900abcc222ea58ad8b7b6f6cee305",
    "qa": "requires independent file QA"
  },
  {
    "file": "ci_lvl_11_lap01b.wav",
    "source_file": "ci_lvl_11_lap01b.wav",
    "speaker": "Daffy Duck",
    "text": "О, просто великолепно! Опять сезон охоты на уток. Хорошо, что я надел этот костюм Робин Гуда, так что этим назойливым охотникам меня не найти.",
    "start": 0.12,
    "end": 9.5,
    "source_seconds": 10.3564375,
    "segments": [
      0,
      1
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 10.125,
    "audio_sha256": "5eb20e1314dd7edf8bdcfb8d95533292e7f6689099ee9d88dc46c4a1ff3369f5",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_goal_01__03.wav",
    "source_file": "cin_goal_01.wav",
    "speaker": "Daffy Duck",
    "text": "И ещё одна победа нашего участника!",
    "start": 30.2,
    "end": 33.3,
    "source_seconds": 33.942625,
    "segments": [
      3
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 7.289666666666666,
    "audio_sha256": "37c9b316680d21fca42e9b8d148c5b5663fb42c506216a0d6e177e76d40635ea",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_lvl_0207__02.wav",
    "source_file": "cin_lvl_0207.wav",
    "speaker": "Daffy Duck",
    "text": "Если будут ещё вопросы, можешь вернуться ко мне.",
    "start": 5.14,
    "end": 8.04,
    "source_seconds": 15.96525,
    "segments": [
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 6.582833333333333,
    "audio_sha256": "85ab596dabef4df8a9d747ee1cb2f13f8ef3e93c22da470f736fd513b84fa4d0",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_lvl_0209.wav",
    "source_file": "cin_lvl_0209.wav",
    "speaker": "Daffy Duck",
    "text": "Хорошо! Начинай, когда захочешь.",
    "start": 0.18,
    "end": 2.25,
    "source_seconds": 3.0718125,
    "segments": [
      0
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 3.7945416666666665,
    "audio_sha256": "04c9933c709fdbd0893bf5d19ce20f2eb1a35452cf7e975806d0d932c1e94419",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_lvl_0306.wav",
    "source_file": "cin_lvl_0306.wav",
    "speaker": "Daffy Duck",
    "text": "Нет, нет, нет! Прячься за камнем! Отойди за линию, если хочешь начать заново.",
    "start": 0.0,
    "end": 7.6,
    "source_seconds": 8.1346875,
    "segments": [
      0,
      1,
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 7.203791666666667,
    "audio_sha256": "9d7bc4f01b9af1ad090d1dd9d288adfc119d1d9a86cfbe68bce67a065b969e2f",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_lvl_0308.wav",
    "source_file": "cin_lvl_0308.wav",
    "speaker": "Daffy Duck",
    "text": "За камнями можно прятаться, удерживая кнопку скрытности.",
    "start": 0.08,
    "end": 4.54,
    "source_seconds": 5.423875,
    "segments": [
      0
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 4.749458333333333,
    "audio_sha256": "38947da37be765624eb207fda4e3b16358c6b9094ee2029ba2e960b8067e24c9",
    "qa": "requires independent file QA"
  },
  {
    "file": "cin_lvl_0309.wav",
    "source_file": "cin_lvl_0309.wav",
    "speaker": "Daffy Duck",
    "text": "Не хочешь оставаться в неведении, а? Или хочешь? Что ж, если хочешь видеть, что происходит вокруг, используй кнопки камеры. А ещё можно использовать предметы.",
    "start": 0.08,
    "end": 10.16,
    "source_seconds": 10.9046875,
    "segments": [
      0,
      1,
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 12.7895,
    "audio_sha256": "bcbca307e373aac17c1ff22502d9ea876d3da61cfd0ba023f7f188db50e88aab",
    "qa": "requires independent file QA"
  },
  {
    "file": "cinfl_lvl0401__01.wav",
    "source_file": "cinfl_lvl0401.wav",
    "speaker": "Daffy Duck",
    "text": "Ой!",
    "start": 17.65,
    "end": 18.7,
    "source_seconds": 63.4819375,
    "segments": [
      1
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 3.49875,
    "audio_sha256": "553a34995c54ca22add62140f9e6bcb27001f0586694fb02ba3f833da5de06ff",
    "qa": "requires independent file QA"
  },
  {
    "file": "cinfl_lvl0401__02.wav",
    "source_file": "cinfl_lvl0401.wav",
    "speaker": "Daffy Duck",
    "text": "Та-дам!",
    "start": 21.05,
    "end": 22.45,
    "source_seconds": 63.4819375,
    "segments": [
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 1.913375,
    "audio_sha256": "4511305424aa2653e19b92888fbf861e0a54b26c1f23b028a64777cad29362b3",
    "qa": "requires independent file QA"
  },
  {
    "file": "cinfl_lvl0401__03.wav",
    "source_file": "cinfl_lvl0401.wav",
    "speaker": "Daffy Duck",
    "text": "Это я, пленительный лесной эльф!",
    "start": 23.2,
    "end": 25.75,
    "source_seconds": 63.4819375,
    "segments": [
      3
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 3.1647916666666664,
    "audio_sha256": "af7b4150f965f22f2943b350a09ed99a35740379bfb509a9e0eefe020b4d0b3c",
    "qa": "requires independent file QA"
  },
  {
    "file": "cinfl_lvl0402.wav",
    "source_file": "cinfl_lvl0402.wav",
    "speaker": "Daffy Duck",
    "text": "Волшебная флейта просто потрясающа! С ней можно загипнотизировать кого угодно и увести за собой куда захочешь! Пожалуй, надо опробовать её на своём агенте.",
    "start": 0.0,
    "end": 11.4,
    "source_seconds": 11.9886875,
    "segments": [
      0,
      1,
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 12.503041666666666,
    "audio_sha256": "579d2a109ca372f7572c66f48325bc75503626ecefb7e5213738c5cbd45b4768",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__02.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "Слушай, приятель, всё, что тебе нужно — расслабиться и играть. А я использую эту работёнку, чтобы взлететь на вершину суперславы!",
    "start": 99.9,
    "end": 107.8,
    "source_seconds": 191.9705,
    "segments": [
      2
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 9.667,
    "audio_sha256": "7245357a95f9969b42ca2ddc06676969e3a6a113b7631fe898836677ad2f1d8f",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__03.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "Итак, цель нашей игры проста: воровать овец.",
    "start": 108.3,
    "end": 113.0,
    "source_seconds": 191.9705,
    "segments": [
      3
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 6.372916666666667,
    "audio_sha256": "53436ea339fdcfd1121d4d47a96cd5545ac761eb317646cd79d785dc6377304c",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__08.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "Я предельно ясно выразился?",
    "start": 161.2,
    "end": 164.2,
    "source_seconds": 191.9705,
    "segments": [
      8
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 3.7468333333333335,
    "audio_sha256": "4ef324ea1cb816073d1aa9a504afd858b11939b74fb3e311c8bcadcc51a243c8",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__11.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "Это твой звёздный час, и ты ведь не хочешь всё запороть.",
    "start": 176.2,
    "end": 180.0,
    "source_seconds": 191.9705,
    "segments": [
      11
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 5.790208333333333,
    "audio_sha256": "4575c89148600bf0e8ed767a0f891eb2139d66c18747fec760541f82c297d5ec",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__12.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "К тому же, это я объяснил тебе правила игры.",
    "start": 180.0,
    "end": 183.0,
    "source_seconds": 191.9705,
    "segments": [
      12
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 4.501333333333333,
    "audio_sha256": "71998af4a298b5dcc64b3c3115f29538eefb9bd099e14ab627a1b1643ea5c5e4",
    "qa": "requires independent file QA"
  },
  {
    "file": "intro_2sec__13.wav",
    "source_file": "intro_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "И если ты облажаешься, как я буду выглядеть? Не очень-то круто, вот как!",
    "start": 183.1,
    "end": 188.3,
