    "audio_sha256": "c037f233a643c1adb971a0e13e14e5355f7e8cb3308b81482d2a692873352c15",
    "qa": "requires independent file QA"
  },
  {
    "file": "Mars_2sec__08.wav",
    "source_file": "Mars_2sec.wav",
    "speaker": "Daffy Duck",
    "text": "Что здесь делает марсианин Марвин?",
    "start": 33.35,
    "end": 36.05,
    "source_seconds": 208.7134375,
    "segments": [
      8
    ],
    "provider": "OpenAI",
    "voice": "ballad",
    "model": "gpt-4o-mini-tts-2025-12-15",
    "seconds": 4.166666666666667,
    "audio_sha256": "9e8c52b1cdc372f7e91c0feb8f5ae2ab05ab06dfd8323af35f930fa79e4dd33f",
    "qa": "requires independent file QA"
  },
  {
    "file": "be_02.wav",
    "source_file": "be_02.wav",
    "speaker": "Daffy Duck",
    "text": "Кто-нибудь, свяжите меня с моим агентом! Я не могу работать в таких условиях!",
    "start": 0.1,
    "end": 4.28,
    "source_seconds": 5.0536875,
    "segments": [
      0
    ],
    "provider": "OpenAI",
    "voice": "ballad",
