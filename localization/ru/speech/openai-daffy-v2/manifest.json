    "audio_sha256": "449a6af0e6028507f613e3c077f14302e18b10ff997d9509f1d4badab7d6256b",
    "qa": "requires independent file QA"
  },
  {
    "file": "be_04__01.wav",
    "source_file": "be_04.wav",
    "speaker": "Daffy Duck",
    "text": "И так далее.",
    "start": 17.4,
    "end": 18.55,
    "source_seconds": 19.092,
    "segments": [
      1
    ],
    "provider": "OpenAI",
    "voice": "ballad",
